# Layer 1 just pulls in steamrt and makes sure we have a rust toolchain
FROM registry.gitlab.steamos.cloud/steamrt/steamrt4/sdk:latest AS aleph-steamrt-base

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain stable \
    && rm /tmp/rustup-init.sh \
    && curl https://nodejs.org/dist/v26.12.0/node-v26.12.0-linux-x64.tar.xz -o /tmp/node.tar.xz \
    && tar -xf /tmp/node.tar.xz -C /root \
    && rm /tmp/node.tar.xz
    
ENV PATH="/root/.cargo/bin:${PATH}"

# Layer 2 will build only the third party dependencies via into a known location
FROM aleph-steamrt-base AS aleph-steamrt-workspace

COPY --from=project utils /root/utils

RUN /root/node-v26.12.0-linux-x64/bin/node /root/utils/3rdparty/build.mts --build-root /root/deps --cmake-dir /root/utils/3rdparty --no-tracy

ENV ALEPH_DEPS_DIR="/root/deps"

# Layer 3 will build aleph-test
FROM aleph-steamrt-workspace AS aleph-steamrt-builder

WORKDIR /aleph
